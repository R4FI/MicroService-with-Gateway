# Dockerfile for API Gateway
# Creates a lightweight Nginx-based container to act as the API Gateway

# Use official Nginx image with Alpine Linux (smaller size, faster builds)
# Alpine is a minimal Linux distribution perfect for containers
FROM nginx:alpine

# Copy custom Nginx configuration to replace the default one
# This configuration defines routing rules for our microservices
COPY nginx.conf /etc/nginx/nginx.conf

# Expose port 80 to allow external access to the gateway
# This is the single entry point for all API requests
EXPOSE 80

# Add a health check to monitor gateway status
# Docker will run this command periodically to verify the container is healthy
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# The base nginx:alpine image already has CMD to start nginx
# It runs: nginx -g 'daemon off;' (keeps nginx in foreground for Docker)
